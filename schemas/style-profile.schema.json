{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "pace",
    "captionStyle",
    "motionDensity",
    "zoomIntensity",
    "soundDesign",
    "visualDepth",
    "transitionStyle",
    "accent",
    "fontFamily",
    "captionSize",
    "captionBottom",
    "maxHighlights",
    "minSoundGap",
    "soundVolume",
    "maxSimultaneousVisuals"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^santtos-"
    },
    "pace": {
      "enum": [
        "slow",
        "medium",
        "medium-fast",
        "fast"
      ]
    },
    "captionStyle": {
      "enum": [
        "clean",
        "emphasis",
        "kinetic"
      ]
    },
    "motionDensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "zoomIntensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.25
    },
    "soundDesign": {
      "enum": [
        "off",
        "subtle"
      ]
    },
    "visualDepth": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "transitionStyle": {
      "enum": [
        "invisible"
      ]
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "fontFamily": {
      "type": "string",
      "minLength": 1
    },
    "captionSize": {
      "type": "number",
      "minimum": 30,
      "maximum": 90
    },
    "captionBottom": {
      "type": "number",
      "minimum": 180,
      "maximum": 500
    },
    "maxHighlights": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "minSoundGap": {
      "type": "number",
      "minimum": 1,
      "maximum": 10
    },
    "soundVolume": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.3
    },
    "maxSimultaneousVisuals": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  }
}
